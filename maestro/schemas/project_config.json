{
  "$defs": {
    "AgentType": {
      "description": "Supported agent types for task execution.",
      "enum": [
        "claude_code",
        "codex_cli",
        "aider",
        "announce",
        "opencode",
        "auto"
      ],
      "title": "AgentType",
      "type": "string"
    },
    "ArbiterConfig": {
      "additionalProperties": false,
      "description": "Configuration for the Arbiter MCP integration.\n\nValidated on YAML load. `enabled=false` (default) keeps Maestro on the\nzero-config StaticRouting path; no arbiter subprocess ever started.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/ArbiterMode",
          "default": "advisory"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "binary_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binary Path"
        },
        "config_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Dir"
        },
        "tree_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tree Path"
        },
        "db_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Db Path"
        },
        "timeout_ms": {
          "default": 500,
          "minimum": 1,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "reconnect_interval_s": {
          "default": 60,
          "minimum": 1,
          "title": "Reconnect Interval S",
          "type": "integer"
        },
        "abandon_outcome_after_s": {
          "default": 300,
          "minimum": 1,
          "title": "Abandon Outcome After S",
          "type": "integer"
        },
        "log_level": {
          "default": "warn",
          "title": "Log Level",
          "type": "string"
        }
      },
      "title": "ArbiterConfig",
      "type": "object"
    },
    "ArbiterMode": {
      "description": "Arbiter routing authority.\n\nADVISORY \u2014 explicit `agent_type` in task config is honored; arbiter is\nconsulted for learning signal and can HOLD/REJECT on invariants.\nAUTHORITATIVE \u2014 arbiter's `chosen_agent` overrides user declaration.",
      "enum": [
        "advisory",
        "authoritative"
      ],
      "title": "ArbiterMode",
      "type": "string"
    },
    "BackendSpec": {
      "description": "A named execution backend: how to reach it, and how to isolate it.",
      "properties": {
        "transport": {
          "discriminator": {
            "mapping": {
              "local": "#/$defs/LocalTransport",
              "ssh": "#/$defs/SshTransport"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/LocalTransport"
            },
            {
              "$ref": "#/$defs/SshTransport"
            }
          ],
          "title": "Transport"
        },
        "isolation": {
          "discriminator": {
            "mapping": {
              "bare": "#/$defs/BareIsolation",
              "docker": "#/$defs/DockerIsolation"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BareIsolation"
            },
            {
              "$ref": "#/$defs/DockerIsolation"
            }
          ],
          "title": "Isolation"
        },
        "secret_env": {
          "items": {
            "type": "string"
          },
          "title": "Secret Env",
          "type": "array"
        },
        "inherit_secret_defaults": {
          "default": false,
          "title": "Inherit Secret Defaults",
          "type": "boolean"
        },
        "max_concurrent": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Concurrent"
        }
      },
      "required": [
        "transport",
        "isolation"
      ],
      "title": "BackendSpec",
      "type": "object"
    },
    "BareIsolation": {
      "description": "No isolation; the harness runs directly on the transport's target.",
      "properties": {
        "type": {
          "const": "bare",
          "default": "bare",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "BareIsolation",
      "type": "object"
    },
    "Complexity": {
      "description": "Arbiter-compatible task complexity classification.\n\nValues match `arbiter-core/src/types.rs::Complexity`. Maestro's default\ninference uses scope size as a proxy; callers can override when they\nhave richer signal (token estimates, subtask count, etc.).",
      "enum": [
        "trivial",
        "simple",
        "moderate",
        "complex",
        "critical"
      ],
      "title": "Complexity",
      "type": "string"
    },
    "DefaultsConfig": {
      "description": "Default values for task configuration.",
      "properties": {
        "timeout_minutes": {
          "default": 30,
          "description": "Default timeout in minutes",
          "maximum": 1440,
          "minimum": 1,
          "title": "Timeout Minutes",
          "type": "integer"
        },
        "max_retries": {
          "default": 2,
          "description": "Default max retries",
          "maximum": 10,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "agent_type": {
          "$ref": "#/$defs/AgentType",
          "default": "claude_code",
          "description": "Default agent type"
        }
      },
      "title": "DefaultsConfig",
      "type": "object"
    },
    "DockerConfig": {
      "description": "Local Docker isolator configuration.",
      "properties": {
        "image": {
          "title": "Image",
          "type": "string"
        },
        "network": {
          "default": "none",
          "title": "Network",
          "type": "string"
        },
        "memory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory"
        },
        "cpus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpus"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        },
        "secret_env": {
          "items": {
            "type": "string"
          },
          "title": "Secret Env",
          "type": "array"
        }
      },
      "required": [
        "image"
      ],
      "title": "DockerConfig",
      "type": "object"
    },
    "DockerIsolation": {
      "description": "Isolate the harness inside a Docker container.",
      "properties": {
        "type": {
          "const": "docker",
          "title": "Type",
          "type": "string"
        },
        "image": {
          "title": "Image",
          "type": "string"
        },
        "network": {
          "default": "none",
          "title": "Network",
          "type": "string"
        },
        "memory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory"
        },
        "cpus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpus"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        }
      },
      "required": [
        "type",
        "image"
      ],
      "title": "DockerIsolation",
      "type": "object"
    },
    "ExecutionConfig": {
      "description": "The `execution:` block. Absent \u2192 `local + bare`, old behavior.\n\n`backends` is the canonical named registry (transport x isolation). The\nPhase-1 `docker` field is a legacy shorthand normalized into\n`backends[\"docker\"]`. `local` is always implicit.",
      "properties": {
        "default_backend": {
          "default": "local",
          "title": "Default Backend",
          "type": "string"
        },
        "secret_env_defaults": {
          "items": {
            "type": "string"
          },
          "title": "Secret Env Defaults",
          "type": "array"
        },
        "backends": {
          "additionalProperties": {
            "$ref": "#/$defs/BackendSpec"
          },
          "title": "Backends",
          "type": "object"
        },
        "docker": {
          "anyOf": [
            {
              "$ref": "#/$defs/DockerConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ExecutionConfig",
      "type": "object"
    },
    "GitConfig": {
      "description": "Git configuration for project.",
      "properties": {
        "base_branch": {
          "default": "main",
          "description": "Base branch name",
          "title": "Base Branch",
          "type": "string"
        },
        "auto_push": {
          "default": true,
          "description": "Automatically push after task",
          "title": "Auto Push",
          "type": "boolean"
        },
        "auto_commit": {
          "default": false,
          "description": "Auto-commit changes after each task completes",
          "title": "Auto Commit",
          "type": "boolean"
        },
        "branch_prefix": {
          "default": "agent/",
          "description": "Prefix for task branches",
          "title": "Branch Prefix",
          "type": "string"
        }
      },
      "title": "GitConfig",
      "type": "object"
    },
    "Language": {
      "description": "Arbiter-compatible primary language classification.\n\nValues match `arbiter-core/src/types.rs::Language`. `MIXED` means the\ntask spans multiple languages; `OTHER` is the fallback when inference\ncannot determine a single language.",
      "enum": [
        "python",
        "rust",
        "typescript",
        "go",
        "mixed",
        "other"
      ],
      "title": "Language",
      "type": "string"
    },
    "LocalTransport": {
      "description": "Run the harness in-process on the local machine.",
      "properties": {
        "type": {
          "const": "local",
          "default": "local",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "LocalTransport",
      "type": "object"
    },
    "NotificationConfig": {
      "description": "Notification configuration.",
      "properties": {
        "desktop": {
          "default": true,
          "description": "Enable desktop notifications",
          "title": "Desktop",
          "type": "boolean"
        },
        "telegram_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DEPRECATED (non-functional; use webhook_url)",
          "title": "Telegram Token"
        },
        "telegram_chat_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DEPRECATED (non-functional; use webhook_url)",
          "title": "Telegram Chat Id"
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Webhook URL for notifications (POSTs the versioned maestro.notification/v1 JSON envelope)",
          "title": "Webhook Url"
        }
      },
      "title": "NotificationConfig",
      "type": "object"
    },
    "SshTransport": {
      "description": "Run the harness on a remote host reached over SSH.",
      "properties": {
        "type": {
          "const": "ssh",
          "title": "Type",
          "type": "string"
        },
        "host": {
          "title": "Host",
          "type": "string"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        },
        "port": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "workdir_root": {
          "title": "Workdir Root",
          "type": "string"
        },
        "connect_timeout_s": {
          "default": 10,
          "title": "Connect Timeout S",
          "type": "integer"
        },
        "ssh_opts": {
          "items": {
            "type": "string"
          },
          "title": "Ssh Opts",
          "type": "array"
        }
      },
      "required": [
        "type",
        "host",
        "workdir_root"
      ],
      "title": "SshTransport",
      "type": "object"
    },
    "TaskConfig": {
      "description": "Task configuration model for YAML parsing.\n\nThis model represents a task definition as specified in the YAML config file.\nIt is used for parsing and validating task configurations before they are\nconverted to runtime Task instances.",
      "properties": {
        "id": {
          "description": "Unique task identifier",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "description": "Human-readable task title",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "prompt": {
          "description": "Task prompt for the agent",
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "agent_type": {
          "$ref": "#/$defs/AgentType",
          "default": "claude_code",
          "description": "Type of agent to execute the task"
        },
        "scope": {
          "description": "File/directory globs that the task can modify",
          "items": {
            "type": "string"
          },
          "title": "Scope",
          "type": "array"
        },
        "depends_on": {
          "description": "List of task IDs this task depends on",
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "timeout_minutes": {
          "default": 30,
          "description": "Task timeout in minutes (1-1440)",
          "maximum": 1440,
          "minimum": 1,
          "title": "Timeout Minutes",
          "type": "integer"
        },
        "max_retries": {
          "default": 2,
          "description": "Maximum retry attempts (0-10)",
          "maximum": 10,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "validation_cmd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Command to validate task completion",
          "title": "Validation Cmd"
        },
        "requires_approval": {
          "default": false,
          "description": "Whether task requires manual approval before start",
          "title": "Requires Approval",
          "type": "boolean"
        },
        "priority": {
          "default": 0,
          "description": "Task priority (-100 to 100)",
          "maximum": 100,
          "minimum": -100,
          "title": "Priority",
          "type": "integer"
        },
        "task_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskType"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Arbiter task type. If omitted, inferred from `prompt` at Task.from_config() time."
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/Language"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Arbiter primary language. If omitted, inferred from `scope` globs at Task.from_config() time."
        },
        "complexity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Complexity"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Arbiter complexity. If omitted, inferred from scope size at Task.from_config() time."
        },
        "backend": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Execution backend name (local|docker); None -> default_backend",
          "title": "Backend"
        },
        "validation_backend": {
          "default": "same",
          "description": "Backend for the post-task validation run: 'same' (the default \u2014 the task's own backend, so validation runs in the same environment the task ran in) | 'local' | a named backend. Non-local targets run durably; SSH targets are supported.",
          "title": "Validation Backend",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "prompt"
      ],
      "title": "TaskConfig",
      "type": "object"
    },
    "TaskType": {
      "description": "Arbiter-compatible task type classification.\n\nValues match `arbiter-core/src/types.rs::TaskType` (snake_case serde).\nUsed by Arbiter's routing decision tree (ordinal feature, index 0).",
      "enum": [
        "feature",
        "bugfix",
        "refactor",
        "test",
        "docs",
        "review",
        "research"
      ],
      "title": "TaskType",
      "type": "string"
    },
    "VerifierConfig": {
      "additionalProperties": false,
      "description": "Opt-in adversarial LLM verifier-gate config (verifier-gate Mode-1).\n\nAbsent (`None` on `ProjectConfig.verifier`) keeps today's behavior\nbyte-for-byte: no `VERIFYING` phase, `VALIDATING -> DONE` directly.\n`backend` is pinned to `\"local\"` for this slice \u2014 read-only is policy\nisolation (scratch cwd, no collect, envelope on stdin), never OS\nisolation; rejecting any other value at construction time keeps that\nclaim honest. Model resolution is intentionally NOT done here \u2014 see\n`maestro.verifier.config.resolve_verifier_model`, which is isolated from\nthe main `resolve_model` precedence (never reads `MAESTRO_<H>_MODEL` or a\ncatalog default, only `verifier.model` then `MAESTRO_VERIFIER_MODEL`).",
      "properties": {
        "runner": {
          "const": "claude",
          "default": "claude",
          "title": "Runner",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Verifier model id. None defers to $MAESTRO_VERIFIER_MODEL at resolution time; never falls back to a catalog default.",
          "title": "Model"
        },
        "timeout_seconds": {
          "default": 120,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "max_diff_bytes": {
          "default": 100000,
          "minimum": 1,
          "title": "Max Diff Bytes",
          "type": "integer"
        },
        "backend": {
          "default": "local",
          "enum": [
            "local",
            "docker"
          ],
          "title": "Backend",
          "type": "string"
        },
        "docker": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerifierDockerConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "VerifierConfig",
      "type": "object"
    },
    "VerifierDockerConfig": {
      "additionalProperties": false,
      "description": "Tuning for the hardened verifier container (bounds are contract).",
      "properties": {
        "image": {
          "title": "Image",
          "type": "string"
        },
        "user": {
          "title": "User",
          "type": "string"
        },
        "memory": {
          "default": "512m",
          "title": "Memory",
          "type": "string"
        },
        "cpus": {
          "default": "1",
          "title": "Cpus",
          "type": "string"
        },
        "pids_limit": {
          "default": 128,
          "title": "Pids Limit",
          "type": "integer"
        },
        "tmpfs_size": {
          "default": "64m",
          "title": "Tmpfs Size",
          "type": "string"
        }
      },
      "required": [
        "image",
        "user"
      ],
      "title": "VerifierDockerConfig",
      "type": "object"
    }
  },
  "description": "Project configuration model for YAML parsing.\n\nThis is the root configuration model that represents the entire YAML\nconfiguration file including project settings, defaults, and task list.",
  "properties": {
    "project": {
      "description": "Project name",
      "minLength": 1,
      "title": "Project",
      "type": "string"
    },
    "repo": {
      "description": "Repository path",
      "minLength": 1,
      "title": "Repo",
      "type": "string"
    },
    "max_concurrent": {
      "default": 3,
      "description": "Maximum concurrent tasks (1-100)",
      "maximum": 100,
      "minimum": 1,
      "title": "Max Concurrent",
      "type": "integer"
    },
    "tasks": {
      "description": "List of task configurations",
      "items": {
        "$ref": "#/$defs/TaskConfig"
      },
      "title": "Tasks",
      "type": "array"
    },
    "defaults": {
      "anyOf": [
        {
          "$ref": "#/$defs/DefaultsConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default values for tasks"
    },
    "git": {
      "anyOf": [
        {
          "$ref": "#/$defs/GitConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Git configuration"
    },
    "notifications": {
      "anyOf": [
        {
          "$ref": "#/$defs/NotificationConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Notification configuration"
    },
    "arbiter": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArbiterConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional arbiter integration. When omitted/None the scheduler stays on zero-config StaticRouting and no subprocess is spawned."
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Execution backends config; None keeps zero-config local/bare execution (old behavior)."
    },
    "verifier": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerifierConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Opt-in adversarial LLM verifier gate; None keeps VALIDATING -> DONE with no VERIFYING phase (old behavior)."
    }
  },
  "required": [
    "project",
    "repo"
  ],
  "title": "ProjectConfig",
  "type": "object"
}
