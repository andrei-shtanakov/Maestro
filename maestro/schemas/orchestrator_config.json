    },
    "VerifierSpec": {
      "description": "How to invoke the verifier: argv template, no shell interpolation.",
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "error_retry_budget": {
          "maximum": 10,
          "minimum": 0,
          "title": "Error Retry Budget",
          "type": "integer"
        }
      },
      "required": [
        "argv",
        "timeout_seconds",
        "error_retry_budget"
      ],
      "title": "VerifierSpec",
      "type": "object"
    },
    "WorkspacePolicy": {
      "description": "Per-role write authority + declared outputs (\u00a76). Declarative only.",
      "properties": {
        "roles": {
          "additionalProperties": {
