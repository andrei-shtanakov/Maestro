      "title": "SshTransport",
      "type": "object"
    },
    "VerificationSection": {
      "description": "Workstream-final verification; presence activates VERIFYING (\u00a74, \u00a79).",
      "properties": {
        "verifier": {
          "$ref": "#/$defs/VerifierSpec"
        },
        "artifact": {
          "title": "Artifact",
          "type": "string"
        },
        "rework_budget": {
          "maximum": 10,
          "minimum": 0,
          "title": "Rework Budget",
