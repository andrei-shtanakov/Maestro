{
  "$defs": {
    "ApproverConfig": {
      "additionalProperties": false,
      "description": "approver_cmd hook config (#137, spec \u00a74). Opt-in inside `gates:`.\n\nAn ex-post gate block normally waits for a human\n`maestro workstream-approve`; with this block configured, an external\ncommand (independent critics; consensus policy lives in the command)\nmay approve instead \u2014 through the same single-authority approval\nAPI, recorded with `actor='agent'`. Fail-closed at every step: any\ntimeout/error/protocol violation leaves the workstream in\nNEEDS_REVIEW for the operator. The environment variable\n`MAESTRO_APPROVER_DISABLED=1` is an operational kill-switch on top\nof `enabled`.",
      "properties": {
        "cmd": {
          "description": "argv list executed without a shell; envelope on stdin",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Cmd",
          "type": "array"
        },
        "timeout_seconds": {
          "default": 600,
          "description": "Whole-command wall clock",
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "enabled": {
          "default": true,
          "description": "Config kill-switch",
          "title": "Enabled",
          "type": "boolean"
        },
        "max_auto_approvals": {
          "default": 2,
          "description": "AUTHORITY budget: agent approvals per workstream",
          "minimum": 0,
          "title": "Max Auto Approvals",
          "type": "integer"
        },
        "max_evaluations": {
          "default": 5,
          "description": "EXECUTION budget: attempts per workstream, any SHA/outcome",
          "minimum": 0,
          "title": "Max Evaluations",
          "type": "integer"
        },
        "max_escaped_paths": {
          "default": 20,
          "description": "More escapes -> straight to human",
          "minimum": 0,
          "title": "Max Escaped Paths",
          "type": "integer"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hard fail-closed budget over REPORTED costs; any attempt with unreported cost blocks further auto-runs",
          "title": "Max Cost Usd"
        },
        "max_diff_bytes": {
          "default": 262144,
          "description": "Bigger diff -> straight to human",
          "exclusiveMinimum": 0,
          "title": "Max Diff Bytes",
          "type": "integer"
        },
        "max_stdout_bytes": {
          "default": 1048576,
          "description": "Exceeded -> protocol ERROR",
          "exclusiveMinimum": 0,
          "title": "Max Stdout Bytes",
          "type": "integer"
        },
        "max_stderr_bytes": {
          "default": 262144,
          "description": "Capture bound; never stored in DB",
          "exclusiveMinimum": 0,
          "title": "Max Stderr Bytes",
          "type": "integer"
        }
      },
      "required": [
        "cmd"
      ],
      "title": "ApproverConfig",
      "type": "object"
    },
    "ArbiterConfig": {
      "additionalProperties": false,
      "description": "Configuration for the Arbiter MCP integration.\n\nValidated on YAML load. `enabled=false` (default) keeps Maestro on the\nzero-config StaticRouting path; no arbiter subprocess ever started.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/ArbiterMode",
          "default": "advisory"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "binary_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binary Path"
        },
        "config_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Dir"
        },
        "tree_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tree Path"
        },
        "db_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Db Path"
        },
        "timeout_ms": {
          "default": 500,
          "minimum": 1,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "reconnect_interval_s": {
          "default": 60,
          "minimum": 1,
          "title": "Reconnect Interval S",
          "type": "integer"
        },
        "abandon_outcome_after_s": {
          "default": 300,
          "minimum": 1,
          "title": "Abandon Outcome After S",
          "type": "integer"
        },
        "log_level": {
          "default": "warn",
          "title": "Log Level",
          "type": "string"
        }
      },
      "title": "ArbiterConfig",
      "type": "object"
    },
    "ArbiterMode": {
      "description": "Arbiter routing authority.\n\nADVISORY \u2014 explicit `agent_type` in task config is honored; arbiter is\nconsulted for learning signal and can HOLD/REJECT on invariants.\nAUTHORITATIVE \u2014 arbiter's `chosen_agent` overrides user declaration.",
      "enum": [
        "advisory",
        "authoritative"
      ],
      "title": "ArbiterMode",
      "type": "string"
    },
    "BackendSpec": {
      "description": "A named execution backend: how to reach it, and how to isolate it.",
      "properties": {
        "transport": {
          "discriminator": {
            "mapping": {
              "local": "#/$defs/LocalTransport",
              "ssh": "#/$defs/SshTransport"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/LocalTransport"
            },
            {
              "$ref": "#/$defs/SshTransport"
            }
          ],
          "title": "Transport"
        },
        "isolation": {
          "discriminator": {
            "mapping": {
              "bare": "#/$defs/BareIsolation",
              "docker": "#/$defs/DockerIsolation"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BareIsolation"
            },
            {
              "$ref": "#/$defs/DockerIsolation"
            }
          ],
          "title": "Isolation"
        },
        "secret_env": {
          "items": {
            "type": "string"
          },
          "title": "Secret Env",
          "type": "array"
        },
        "inherit_secret_defaults": {
          "default": false,
          "title": "Inherit Secret Defaults",
          "type": "boolean"
        },
        "max_concurrent": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Concurrent"
        }
      },
      "required": [
        "transport",
        "isolation"
      ],
      "title": "BackendSpec",
      "type": "object"
    },
    "BareIsolation": {
      "description": "No isolation; the harness runs directly on the transport's target.",
      "properties": {
        "type": {
          "const": "bare",
          "default": "bare",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "BareIsolation",
      "type": "object"
    },
    "CriteriaConfig": {
      "description": "Rubric reference. `source` is a reference, never inline rubric bytes.\n\nFor visibility=shared the source is a repo-relative path; for\nverifier_only it is an operator-side reference whose BYTES are the only\nsecret \u2014 the reference string itself is visible to the author (\u00a77, \u00a79).",
      "properties": {
        "visibility": {
          "enum": [
            "shared",
            "verifier_only"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "visibility",
        "source",
        "sha256"
      ],
      "title": "CriteriaConfig",
      "type": "object"
    },
    "DeliveryPolicy": {
      "description": "Declare-and-validate: names the one supported semantics (\u00a78).",
      "properties": {
        "local_merge": {
          "const": "before_remote_pr",
          "title": "Local Merge",
          "type": "string"
        },
        "remote": {
          "const": "github_pr",
          "title": "Remote",
          "type": "string"
        },
        "evidence": {
          "const": "all",
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "local_merge",
        "remote",
        "evidence"
      ],
      "title": "DeliveryPolicy",
      "type": "object"
    },
    "DockerConfig": {
      "description": "Local Docker isolator configuration.",
      "properties": {
        "image": {
          "title": "Image",
          "type": "string"
        },
        "network": {
          "default": "none",
          "title": "Network",
          "type": "string"
        },
        "memory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory"
        },
        "cpus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpus"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        },
        "secret_env": {
          "items": {
            "type": "string"
          },
          "title": "Secret Env",
          "type": "array"
        }
      },
      "required": [
        "image"
      ],
      "title": "DockerConfig",
      "type": "object"
    },
    "DockerIsolation": {
      "description": "Isolate the harness inside a Docker container.",
      "properties": {
        "type": {
          "const": "docker",
          "title": "Type",
          "type": "string"
        },
        "image": {
          "title": "Image",
          "type": "string"
        },
        "network": {
          "default": "none",
          "title": "Network",
          "type": "string"
        },
        "memory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory"
        },
        "cpus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpus"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        }
      },
      "required": [
        "type",
        "image"
      ],
      "title": "DockerIsolation",
      "type": "object"
    },
    "DomainProfile": {
      "properties": {
        "verification": {
          "$ref": "#/$defs/VerificationSection"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspacePolicy"
        },
        "delivery": {
          "$ref": "#/$defs/DeliveryPolicy"
        },
        "spec_gen": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpecGenSection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "verification",
        "workspace",
        "delivery"
      ],
      "title": "DomainProfile",
      "type": "object"
    },
    "ExecutionConfig": {
      "description": "The `execution:` block. Absent \u2192 `local + bare`, old behavior.\n\n`backends` is the canonical named registry (transport x isolation). The\nPhase-1 `docker` field is a legacy shorthand normalized into\n`backends[\"docker\"]`. `local` is always implicit.",
      "properties": {
        "default_backend": {
          "default": "local",
          "title": "Default Backend",
          "type": "string"
        },
        "secret_env_defaults": {
          "items": {
            "type": "string"
          },
          "title": "Secret Env Defaults",
          "type": "array"
        },
        "backends": {
          "additionalProperties": {
            "$ref": "#/$defs/BackendSpec"
          },
          "title": "Backends",
          "type": "object"
        },
        "docker": {
          "anyOf": [
            {
              "$ref": "#/$defs/DockerConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ExecutionConfig",
      "type": "object"
    },
    "GatesConfig": {
      "additionalProperties": false,
      "description": "Gates-in-DAG guard config (WS-006 skeleton, steward DESIGN-611). Opt-in.\n\nWhen present, the orchestrator evaluates risk gates at two transition\nedges \u2014 ex-ante before READY -> RUNNING (declared workstream scope) and\nex-post before RUNNING -> MERGING (the actual diff) \u2014 by shelling out to\n``steward risk-classify`` (single source of truth for tiers; Maestro never\ncomputes risk itself). ``mode`` is fixed fail_closed: a missing or errored\nverdict on a mandatory gate blocks the transition.",
      "properties": {
        "mode": {
          "const": "fail_closed",
          "default": "fail_closed",
          "title": "Mode",
          "type": "string"
        },
        "steward_bin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to the steward CLI; falls back to $MAESTRO_STEWARD_BIN",
          "title": "Steward Bin"
        },
        "risk_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path passed to --risk-model (default: steward's own default)",
          "title": "Risk Model"
        },
        "profile": {
          "default": "lite",
          "description": "Floor profile for risk-classify",
          "title": "Profile",
          "type": "string"
        },
        "approval_tiers": {
          "default": [
            "high",
            "critical"
          ],
          "description": "Tiers that require a human owner approval before spawn/merge",
          "items": {
            "type": "string"
          },
          "title": "Approval Tiers",
          "type": "array"
        },
        "approver": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApproverConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional approver_cmd hook (#137): auto-approve ex-post gate blocks via an external critic command; absent = wait for the operator (today's behavior)"
        }
      },
      "title": "GatesConfig",
      "type": "object"
    },
    "LocalTransport": {
      "description": "Run the harness in-process on the local machine.",
      "properties": {
        "type": {
          "const": "local",
          "default": "local",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "LocalTransport",
      "type": "object"
    },
    "NotificationConfig": {
      "description": "Notification configuration.",
      "properties": {
        "desktop": {
          "default": true,
          "description": "Enable desktop notifications",
          "title": "Desktop",
          "type": "boolean"
        },
        "telegram_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DEPRECATED (non-functional; use webhook_url)",
          "title": "Telegram Token"
        },
        "telegram_chat_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DEPRECATED (non-functional; use webhook_url)",
          "title": "Telegram Chat Id"
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Webhook URL for notifications (POSTs the versioned maestro.notification/v1 JSON envelope)",
          "title": "Webhook Url"
        }
      },
      "title": "NotificationConfig",
      "type": "object"
    },
    "RoleScopes": {
      "properties": {
        "write": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Write",
          "type": "array"
        }
      },
      "required": [
        "write"
      ],
      "title": "RoleScopes",
      "type": "object"
    },
    "SpecGenSection": {
      "description": "Domain-owned spec-generation budgets; single SSOT rule in preflight.",
      "properties": {
        "budget_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Usd"
        },
        "timeout_minutes": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Minutes"
        }
      },
      "title": "SpecGenSection",
      "type": "object"
    },
    "SpecRunnerConfig": {
      "description": "Configuration passed through to spec-runner.",
      "properties": {
        "max_retries": {
          "default": 3,
          "description": "Max retries per task",
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "task_timeout_minutes": {
          "default": 30,
          "description": "Timeout per task in minutes",
          "minimum": 1,
          "title": "Task Timeout Minutes",
          "type": "integer"
        },
        "claude_command": {
          "default": "claude",
          "description": "Claude CLI command",
          "title": "Claude Command",
          "type": "string"
        },
        "auto_commit": {
          "default": true,
          "description": "Auto-commit after task",
          "title": "Auto Commit",
          "type": "boolean"
        },
        "create_git_branch": {
          "default": true,
          "description": "Create sub-branch per task",
          "title": "Create Git Branch",
          "type": "boolean"
        },
        "run_tests_on_done": {
          "default": true,
          "description": "Run tests after task",
          "title": "Run Tests On Done",
          "type": "boolean"
        },
        "test_command": {
          "default": "uv run pytest",
          "description": "Test command to run",
          "title": "Test Command",
          "type": "string"
        },
        "lint_command": {
          "default": "uv run ruff check .",
          "description": "Lint command to run",
          "title": "Lint Command",
          "type": "string"
        },
        "run_lint_on_done": {
          "default": true,
          "description": "Run lint after task",
          "title": "Run Lint On Done",
          "type": "boolean"
        },
        "spec_gen_budget_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 1.0,
          "description": "USD cap for `spec-runner plan --full` spec generation; None disables the cap",
          "title": "Spec Gen Budget Usd"
        },
        "claude_model": {
          "default": "",
          "description": "Claude model for tasks (empty = CLI default)",
          "title": "Claude Model",
          "type": "string"
        },
        "review_command": {
          "default": "",
          "description": "Review CLI command (empty = claude_command)",
          "title": "Review Command",
          "type": "string"
        },
        "review_model": {
          "default": "",
          "description": "Review model (empty = claude_model)",
          "title": "Review Model",
          "type": "string"
        },
        "extra_executor_config": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Arbitrary overlay merged on top of the generated executor config, for ExecutorConfig fields SpecRunnerConfig doesn't mirror explicitly (e.g. personas, review_parallel, telegram_*, webhook_*, budgets). Deep-merged; keys here win over generated values.",
          "title": "Extra Executor Config"
        }
      },
      "title": "SpecRunnerConfig",
      "type": "object"
    },
    "SshTransport": {
      "description": "Run the harness on a remote host reached over SSH.",
      "properties": {
        "type": {
          "const": "ssh",
          "title": "Type",
          "type": "string"
        },
        "host": {
          "title": "Host",
          "type": "string"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
